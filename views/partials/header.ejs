<!DOCTYPE html>
<html lang="<%= language || 'en' %>" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | FunctionSid</title>
  <meta name="description" content="<%= tt('meta.description') %>">
  <meta property="og:title" content="<%= pageTitle %> | FunctionSid">
  <meta property="og:description" content="<%= tt('meta.description') %>">
  <meta property="og:type" content="<%= tt('meta.ogType') %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/images/functionsid-logo.png">
  <script src="https://unpkg.com/lucide@latest" defer></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a href="#main-content" class="skip-link"><%= t('nav.skipLink') %></a>

  <header class="site-header">
    <nav class="navbar navbar-expand-lg" aria-label="<%= t('nav.mainNavigation') %>">
      <div class="container">
        <a href="/?lang=<%= language %>" class="navbar-brand brand-logo" aria-label="<%= tt('common.functionSidHome') %>">
          <img src="/images/functionsid-logo.png" alt="<%= t('brand.logoAlt') %>" width="40" height="40" class="brand-logo-img">
          <span class="brand-lockup">
            <span class="brand-name">FunctionSid</span>
            <span class="brand-subtitle"><%= tt('common.brandSubtitle') %></span>
          </span>
        </a>

        <div class="header-actions order-lg-3">
          <div class="dropdown">
            <button class="btn btn-secondary-custom btn-icon-text dropdown-toggle" type="button" id="languageMenu" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t('nav.selectLang') %>">
              <i data-lucide="globe-2" aria-hidden="true"></i>
              <span><%= (language || 'en').toUpperCase() %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageMenu">
              <li><button class="dropdown-item" type="button" data-language="en"><%= tt('language.english') %></button></li>
              <li><button class="dropdown-item" type="button" data-language="hi"><%= tt('language.hindi') %></button></li>
              <li><button class="dropdown-item" type="button" data-language="mr"><%= tt('language.marathi') %></button></li>
            </ul>
          </div>

          <button id="themeToggle" class="btn btn-secondary-custom icon-button" type="button" aria-label="<%= t('nav.toggleTheme') %>" aria-pressed="true">
            <i data-lucide="moon" aria-hidden="true"></i>
          </button>

          <button class="navbar-toggler btn btn-secondary-custom icon-button" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNavigation" aria-controls="primaryNavigation" aria-expanded="false" aria-label="<%= t('nav.toggleMenu') %>">
            <i data-lucide="menu" aria-hidden="true"></i>
          </button>
        </div>

        <div class="collapse navbar-collapse order-lg-2" id="primaryNavigation">
          <ul class="navbar-nav ms-lg-auto">
            <% [
              { href: '/', key: 'home', label: t('nav.home') },
              { href: '/about', key: 'about', label: t('nav.about') },
              { href: '/services', key: 'services', label: t('nav.services') },
              { href: '/projects', key: 'projects', label: t('nav.projects') },
              { href: '/skills', key: 'skills', label: t('nav.skills') },
              { href: '/certifications', key: 'certifications', label: t('nav.certifications') },
              { href: '/resume', key: 'resume', label: tt('common.resume') },
              { href: '/contact', key: 'contact', label: t('nav.contact') }
            ].forEach((item) => { %>
              <li class="nav-item">
                <a href="<%= item.href %>?lang=<%= language %>" class="nav-link <%= activePage === item.key ? 'active' : '' %>" <%= activePage === item.key ? 'aria-current="page"' : '' %>><%= item.label %></a>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <main id="main-content" tabindex="-1">
