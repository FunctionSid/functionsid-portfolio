<!DOCTYPE html>
<html lang="<%= language || 'en' %>" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | <%= tt('admin.titleSuffix') %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/images/functionsid-logo.png">
  <script src="https://unpkg.com/lucide@latest" defer></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a href="#main-content" class="skip-link"><%= tt('admin.skip') %></a>
  <header class="site-header">
    <nav class="navbar navbar-expand-lg" aria-label="<%= tt('admin.navigation') %>">
      <div class="container">
        <a href="/admin" class="navbar-brand brand-logo">
          <img src="/images/functionsid-logo.png" alt="" width="40" height="40">
          <span class="brand-lockup">
            <span class="brand-name"><%= tt('admin.brand') %></span>
            <span class="brand-subtitle"><%= tt('admin.subtitle') %></span>
          </span>
        </a>
        <button class="navbar-toggler btn btn-secondary-custom icon-button" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavigation" aria-controls="adminNavigation" aria-expanded="false" aria-label="<%= tt('admin.toggleMenu') %>">
          <i data-lucide="menu" aria-hidden="true"></i>
        </button>
        <div class="collapse navbar-collapse" id="adminNavigation">
          <ul class="navbar-nav ms-lg-auto">
            <li class="nav-item"><a class="nav-link <%= activePage === 'admin-dashboard' ? 'active' : '' %>" href="/admin"><%= tt('admin.dashboard') %></a></li>
            <li class="nav-item"><a class="nav-link <%= activePage === 'admin-messages' ? 'active' : '' %>" href="/admin/messages"><%= tt('admin.messages') %></a></li>
            <li class="nav-item"><a class="nav-link <%= activePage === 'admin-uploads' ? 'active' : '' %>" href="/admin/uploads"><%= tt('admin.uploads') %></a></li>
            <li class="nav-item"><a class="nav-link" href="/"><%= tt('admin.publicSite') %></a></li>
            <% if (adminUser) { %>
              <li class="nav-item">
                <form action="/admin/logout" method="POST" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="nav-link button-link"><%= tt('admin.logout') %></button>
                </form>
              </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>
  </header>
  <main id="main-content" tabindex="-1">
