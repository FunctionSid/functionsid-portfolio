NODE_ENV=development
PORT=3000
SESSION_SECRET=replace_with_long_random_session_secret

ADMIN_EMAIL=functionsid@gmail.com

DB_USER=FUNCTIONSID
DB_PASSWORD=replace_with_functionsid_schema_password
DB_CONNECT_STRING=sidcore_high
DB_WALLET_DIR=replace_with_oracle_wallet_directory
DB_WALLET_PASSWORD=replace_with_oracle_wallet_password
TNS_ADMIN=replace_with_oracle_wallet_directory
DB_POOL_MIN=1
DB_POOL_MAX=4
DB_POOL_INCREMENT=1
DB_POOL_QUEUE_TIMEOUT=120000
DB_POOL_CONNECT_TIMEOUT=60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password

FIREBASE_API_KEY=replace_with_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=replace_with_firebase_auth_domain
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_STORAGE_BUCKET=replace_with_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=replace_with_firebase_messaging_sender_id
FIREBASE_APP_ID=replace_with_firebase_web_app_id
FIREBASE_CLIENT_EMAIL=replace_with_firebase_admin_client_email
FIREBASE_PRIVATE_KEY=replace_with_firebase_private_key_with_escaped_newlines

# Optional one-time schema initialization only. Do not keep these in normal runtime .env files.
DB_ADMIN_USER=ADMIN
DB_ADMIN_PASSWORD=replace_with_existing_oracle_admin_password
DB_APP_SCHEMA=FUNCTIONSID
